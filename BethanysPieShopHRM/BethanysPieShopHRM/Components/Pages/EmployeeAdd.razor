@page "/employeeadd"

<h3>Add New Employee</h3>

@if (!IsSaved)
{
    <EditForm Model="Employee" OnSubmit="OnSubmit" Enhance FormName="AddEmployeeForm">
        <div class="row mb-3">
            <label for="lastName" class="col-form-label col-md-3">Last Name: </label>
            <div class="col-md-8">
                <InputText class="form-control col-md-8" id="lastName" @bind-Value="Employee.LastName" placeholder="Enter last name" required />
            </div>
        </div>
        <div class="row mb-3">
            <label for="firstName" class="col-form-label col-md-3">First Name: </label>
            <div class="col-md-8">
                <InputText class="form-control col-md-8" id="firstName" @bind-Value="Employee.FirstName" placeholder="Enter first name" required />
            </div>
        </div>
        <div class="row mb-3">
            <label for="email" class="col-form-label col-md-3">Email: </label>
            <div class="col-md-8">
                <InputText class="form-control col-md-8" id="email" @bind-Value="Employee.Email" placeholder="Enter email" required />
            </div>
        </div>
        <div class="row mb-3">
            <label for="comment" class="col-form-label col-md-3">Comment: </label>
            <div class="col-md-8">
                <InputTextArea class="form-control" id="comment" @bind-Value="Employee.Comment" placeholder="Enter comment" />
            </div>
        </div>
        <div>
            <button type="submit" class="btn btn-outline-primary ms-1">Add Employee</button>
        </div>
    </EditForm>
}
else 
{
    <h4 class="text-success">@Message</h4>
}

